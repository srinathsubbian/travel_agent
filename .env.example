# LLM for explanations and the chat agent. Set ONE key. Without any key the app still works
# (template explanations; the chat agent is disabled).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Your own / self-hosted LLM with an OpenAI-compatible API (vLLM, Ollama, LM Studio, LiteLLM, company gateway):
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=your-model-name
# LLM_TOOLS=auto               # auto | on | off. Use "off" if your model has no tool/function calling
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5
# LLM_PROVIDER=openai          # optional: force "openai" or "anthropic" if both keys are set

# "synthetic" (default, no keys needed) or "amadeus" (falls back to synthetic on errors)
DATA_PROVIDER=synthetic
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

FEEDBACK_FILE=data/feedback.jsonl
